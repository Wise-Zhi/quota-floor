{
  "statusLine": {
    "type": "command",
    "command": "landing claude-statusline"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "landing hook-pre-tool --platform claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "landing hook-user-prompt --platform claude"
          }
        ]
      }
